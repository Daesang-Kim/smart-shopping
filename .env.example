# 공공데이터포털(data.go.kr)에서 발급받은 "한국농수산식품유통공사_일별 도,소매 가격정보" 인증키
KAMIS_SERVICE_KEY=

# 공공데이터포털에서 별도로 활용신청해야 하는 "축산물품질평가원_축산물유통정보" 인증키
EKAPE_SERVICE_KEY=

# Supabase 프로젝트 설정 (docs/db-schema.sql / supabase/migrations 적용 대상)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# /api/cron/sync 를 무단 호출로부터 보호하는 값 (Vercel Cron이 자동으로 Authorization 헤더에 실어 보냄)
CRON_SECRET=

# 가격표 촬영 OCR
GOOGLE_CLOUD_VISION_API_KEY=
